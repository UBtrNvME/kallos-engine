{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "canvas": {
      "bg": {
        "dark": { "$value": "#09090B", "$type": "color", "$description": "Erebus Dark OLED canvas background" },
        "light": { "$value": "#FAFAFA", "$type": "color", "$description": "Aether Light paper canvas background" }
      },
      "surface": {
        "dark": { "$value": "#18181B", "$type": "color", "$description": "Parthenon Surface Dark card plane" },
        "light": { "$value": "#FFFFFF", "$type": "color", "$description": "Parthenon Surface Light card plane" }
      },
      "border": {
        "dark": { "$value": "#27272A", "$type": "color", "$description": "Hairline Structural Border Dark" },
        "light": { "$value": "#E4E4E7", "$type": "color", "$description": "Hairline Structural Border Light" }
      }
    },
    "brand": {
      "primary": {
        "dark": { "$value": "#A855F7", "$type": "color", "$description": "Dionysus Tyrian Violet Primary CTA Dark" },
        "light": { "$value": "#7E22CE", "$type": "color", "$description": "Dionysus Tyrian Violet Primary CTA Light" }
      },
      "secondary": {
        "dark": { "$value": "#3B82F6", "$type": "color", "$description": "Poseidon Aegean Ultramarine Secondary Trigger Dark" },
        "light": { "$value": "#1D4ED8", "$type": "color", "$description": "Poseidon Aegean Ultramarine Secondary Trigger Light" }
      },
      "accent": {
        "dark": { "$value": "#D4FF00", "$type": "color", "$description": "Helios Acid Amber Accent Pop" },
        "light": { "$value": "#D4FF00", "$type": "color", "$description": "Helios Acid Amber Accent Pop" }
      },
      "focus": {
        "dark": { "$value": "#D4FF00", "$type": "color", "$description": "Focus ring outline Dark mode" },
        "light": { "$value": "#7E22CE", "$type": "color", "$description": "Focus ring outline Light mode" }
      }
    },
    "status": {
      "success": {
        "dark": { "$value": "#10B981", "$type": "color", "$description": "Athena Emerald Success Status Dark" },
        "light": { "$value": "#047857", "$type": "color", "$description": "Athena Emerald Success Status Light" }
      },
      "warning": {
        "dark": { "$value": "#F59E0B", "$type": "color", "$description": "Apollo Ochre Warning Status Dark" },
        "light": { "$value": "#B45309", "$type": "color", "$description": "Apollo Ochre Warning Status Light" }
      },
      "error": {
        "dark": { "$value": "#F43F5E", "$type": "color", "$description": "Hades Crimson Error Status Dark" },
        "light": { "$value": "#BE123C", "$type": "color", "$description": "Hades Crimson Error Status Light" }
      },
      "info": {
        "dark": { "$value": "#06B6D4", "$type": "color", "$description": "Hermes Cyan Telemetry Info Dark" },
        "light": { "$value": "#0E7490", "$type": "color", "$description": "Hermes Cyan Telemetry Info Light" }
      }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": { "$value": "'Inter', system-ui, -apple-system, sans-serif", "$type": "fontFamily" },
      "mono": { "$value": "'JetBrains Mono', monospace", "$type": "fontFamily" }
    },
    "fontSize": {
      "xs": { "$value": "0.75rem", "$type": "dimension" },
      "sm": { "$value": "0.875rem", "$type": "dimension" },
      "base": { "$value": "1.0rem", "$type": "dimension" },
      "lg": { "$value": "1.25rem", "$type": "dimension" },
      "xl": { "$value": "1.5rem", "$type": "dimension" },
      "2xl": { "$value": "2.0rem", "$type": "dimension" },
      "3xl": { "$value": "2.5rem", "$type": "dimension" }
    }
  },
  "radii": {
    "none": { "$value": "0px", "$type": "dimension" },
    "sharp": { "$value": "2px", "$type": "dimension" },
    "tactical": { "$value": "4px", "$type": "dimension" },
    "card": { "$value": "8px", "$type": "dimension" }
  },
  "space": {
    "3xs": { "$value": "2px", "$type": "dimension" },
    "2xs": { "$value": "4px", "$type": "dimension" },
    "xs": { "$value": "8px", "$type": "dimension" },
    "sm": { "$value": "12px", "$type": "dimension" },
    "md": { "$value": "16px", "$type": "dimension" },
    "lg": { "$value": "24px", "$type": "dimension" },
    "xl": { "$value": "32px", "$type": "dimension" },
    "2xl": { "$value": "48px", "$type": "dimension" },
    "3xl": { "$value": "64px", "$type": "dimension" }
  }
}
